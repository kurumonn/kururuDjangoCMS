upstream django {
    server web:8000;
}

# 平文 HTTP は一切配信せず、同じホストの HTTPS へ移す。
server {
    listen 80 default_server;
    server_name ${NGINX_SERVER_NAME};
    server_tokens off;

    if ($host != $server_name) {
        return 421;
    }

    return 308 https://$server_name$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name ${NGINX_SERVER_NAME};
    server_tokens off;

    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    if ($host != $server_name) {
        return 421;
    }

    client_max_body_size 6m;

    location /static/ {
        alias /var/www/static/;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /var/www/media/;
        access_log off;
        expires 7d;
        add_header X-Content-Type-Options nosniff;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'";
        location ~ \.(php|phtml|py|pl|cgi|sh)$ {
            return 404;
        }
    }

    location / {
        proxy_pass http://django;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /healthz/ {
        access_log off;
        proxy_pass http://django;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
