# 本番で必要な環境変数の一覧。
#
#   cp .env.example .env
#
# .env は .gitignore に入っている。**絶対にコミットしない**。
# ここにあるのは「名前と説明」だけで、値はすべてダミーである。
#
# production.py の require() が読むものは、未設定だと起動時に落ちる。
# 「動いてしまってから気づく」より、起動しない方が安全なため。

# ---------------------------------------------------------------------------
# 必須（未設定だと起動しない）
# ---------------------------------------------------------------------------

# セッション署名・CSRF トークン・パスワードリセットのリンクに使う。
# 漏れると、他人になりすましたセッションを自作できる。
# 生成:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=ここに生成した値を貼る

# コメントの IP アドレスを HMAC-SHA256 でハッシュ化するときの鍵。
# SECRET_KEY とは別の値にする。
#
# 分ける理由は寿命の違い。SECRET_KEY は漏れたら必ず入れ替えるが、
# 同じ鍵で IP をハッシュしていると、入れ替えた瞬間に過去の
# ハッシュと一致しなくなり、連投検出の履歴が切れる。
#
# この鍵が DB と一緒に漏れると、IPv4 は約43億通りしかないので
# 総当たりで元の IP を復元できる。DB とは別の場所に置くこと。
# 生成:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_COMMENT_IP_HASH_KEY=ここに生成した別の値を貼る

# このサイトが応答してよいホスト名。カンマ区切り。
# 設定しないと DEBUG=False では全リクエストが 400 になる。
DJANGO_ALLOWED_HOSTS=cms.example.com

POSTGRES_DB=kururucms
POSTGRES_USER=kururucms
# 生成:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=ここに生成した値を貼る

DJANGO_EMAIL_HOST=smtp.example.com

# セッション・認証レート制限用。32文字以上のランダム値を使う。
# Django側のRedis URLはこの値から安全に組み立てる。
REDIS_PASSWORD=ここに生成した値を貼る

# Nginx が応答する単一の公開ホスト名。
NGINX_SERVER_NAME=cms.example.com

# PEM形式の証明書チェーンと秘密鍵。リポジトリ外の実ファイルを指定する。
TLS_CERTIFICATE_FILE=/etc/letsencrypt/live/cms.example.com/fullchain.pem
TLS_PRIVATE_KEY_FILE=/etc/letsencrypt/live/cms.example.com/privkey.pem

# ---------------------------------------------------------------------------
# 任意（既定値がある）
# ---------------------------------------------------------------------------

# 管理画面のパス。既定の admin のままだと総当たりの標的になる。
# 推測しにくい文字列にする。ただしこれは目隠しであって、認証の代わりではない。
DJANGO_ADMIN_URL_PATH=admin

# HSTS の有効期間（秒）。
# ★段階的に上げる。いきなり1年にしない。★
# 一度ブラウザーへ送ると取り消せず、証明書が切れたときに
# HTTP へ戻して復旧することができなくなる。
#   3600      = 1時間（最初はこれ）
#   604800    = 1週間（数日様子を見てから）
#   31536000  = 1年（HTTPS が安定してから）
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Nginx の背後にいるので 1。
# 直接インターネットに面しているなら 0。
# 大きすぎると、利用者が偽装した X-Forwarded-For を信じてしまい、
# レート制限とIPブロックを回避される。
DJANGO_TRUSTED_PROXY_COUNT=1

# 管理画面に入れる人へ多要素認証を必須にする。
DJANGO_MFA_REQUIRED_FOR_STAFF=1

# TOTP アプリに表示される発行元名。
DJANGO_MFA_ISSUER=KururuCMS

# バックアップ暗号化用パスフレーズを保存した、ホスト上のファイル。
# 鍵そのものを .env やリポジトリへ書かない。所有者root、権限0600を推奨。
BACKUP_ENCRYPTION_KEY_FILE=/etc/kururucms/backup-passphrase

DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com

# ソーシャルログイン（使わないなら空のまま）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 設定してはいけないもの
# ---------------------------------------------------------------------------
# DJANGO_DEBUG は production.py では読んでいない。
# 環境変数ひとつで本番の DEBUG が有効になる状態を作らないため。
# デバッグしたいときは設定モジュールごと切り替える。
